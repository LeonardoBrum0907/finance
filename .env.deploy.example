# Copie para `.env` na raiz do repo na VPS (não commitado).
# Uso:
#   - Postgres no Docker:  docker compose --profile with-db --profile full up -d --build
#   - Postgres na VPS:     preencha DATABASE_URL e rode:
#                          docker compose --profile full up -d --build

# --- App ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
WEB_ORIGIN=https://financas.seudominio.com
WEB_PORT=8080
API_PORT=3333
NODE_ENV=production

# --- Banco ---
# Opção A — Postgres que você sobe na VPS (fora do Compose):
DATABASE_URL=postgresql://finance:SENHA_FORTE@host.docker.internal:5432/finance?schema=public

# Opção B — Postgres do Compose (--profile with-db). Comente DATABASE_URL acima
# e use estes valores (a API padrão aponta para host `db`):
# POSTGRES_USER=finance
# POSTGRES_PASSWORD=SENHA_FORTE
# POSTGRES_DB=finance
# DATABASE_URL=postgresql://finance:SENHA_FORTE@db:5432/finance?schema=public

# --- Pluggy ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- IA ---
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_FALLBACK_PROVIDER=google
AI_FALLBACK_MODEL=gemini-2.5-flash
AI_MONTHLY_TOKEN_BUDGET=300000
AI_MAX_STEPS=6
AI_MAX_TOOL_CALLS=6
AI_REQUEST_TIMEOUT_MS=90000
AI_REGENERATE_COOLDOWN_MS=5000
AI_PROMPT_CACHE_ENABLED=true
AI_PROMPT_CACHE_KEY_PREFIX=finance
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
