server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Encaminha chamadas de API para o container da API (mesma origem = cookie ok).
    # API_UPSTREAM vem do ambiente (padrão api:3333 no Dockerfile); o nginx:alpine
    # troca só as variáveis definidas, então $host e afins ficam intactos.
    location /api/ {
        # Resolve o nome da API pelo DNS do Docker a cada 10 s e só em IPv4: a
        # API escuta em 0.0.0.0, e na rede do Coolify o nome também tem IPv6,
        # que dava "connection refused" na primeira tentativa. Resolver em
        # tempo de execução também acompanha o IP novo quando a API reinicia.
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
