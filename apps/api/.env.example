# Banco de dados (Postgres via docker-compose)
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"

# Segredo para assinar os JWT de sessao (troque por um valor aleatorio longo)
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Porta da API e origem permitida do frontend (CORS)
PORT=3333
WEB_ORIGIN="http://localhost:5173"

# Credenciais Pluggy (https://dashboard.pluggy.ai -> Configuracoes)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Nao use PLUGGY_API_KEY aqui — o connect token e gerado automaticamente pelo endpoint /api/pluggy/connect-token

# --- IA (chat hibrido: OpenAI primary + Anthropic fallback) ---
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_FALLBACK_PROVIDER="anthropic"
AI_FALLBACK_MODEL="claude-haiku-4-5-20251001"

# Orçamento mensal de tokens por usuario (uso pessoal)
AI_MONTHLY_TOKEN_BUDGET=300000
AI_MAX_STEPS=6
AI_MAX_TOOL_CALLS=6
AI_REQUEST_TIMEOUT_MS=90000
AI_REGENERATE_COOLDOWN_MS=5000

# Prompt caching OpenAI (prefixo estático + promptCacheKey)
AI_PROMPT_CACHE_ENABLED=true
AI_PROMPT_CACHE_KEY_PREFIX=finance

# Chaves de IA (preencha primary e fallback para resiliencia)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Opcional — usado por classifier/recap se AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=""
