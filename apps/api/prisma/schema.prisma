generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  paydayDay                    Int?
  includeInvestmentsInNetWorth Boolean  @default(true)
  theme                        String   @default("default")
  dashboardWidgets             Json?
  /// Módulos opcionais ligados (investimentos, assistente).
  modules                      Json?
  aiTokensUsedThisMonth        Int      @default(0)
  aiUsagePeriod                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  people              Person[]
  chatMessages        ChatMessage[]
  chatThreads         ChatThread[]
  categoryMappings    CategoryMapping[]
  paymentCommitments  PaymentCommitment[]
  simulationScenarios SimulationScenario[]
  recurringBills      RecurringBill[]
  managedAccounts     ManagedAccount[]
}

model Person {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  paydayDay         Int?
  paydayCycleAnchor String   @default("end")
  userId            String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections         BankConnection[]
  simulationScenarios SimulationScenario[]
  recurringBills      RecurringBill[]
  managedAccounts     ManagedAccount[]

  @@index([userId])
}

model BankConnection {
  id                String    @id @default(cuid())
  pluggyItemId      String    @unique
  connectorName     String?
  connectorImageUrl String?
  status            String    @default("UPDATING")
  lastSyncedAt      DateTime?
  /** Quando a Pluggy leu o banco pela última vez (item.lastUpdatedAt). Pode ser bem antes de lastSyncedAt. */
  pluggyUpdatedAt   DateTime?
  personId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  person   Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  accounts Account[]
  investments Investment[]

  @@index([personId])
}

model Account {
  id                   String    @id @default(cuid())
  pluggyAccountId      String    @unique
  name                 String
  type                 String?
  subtype              String?
  number               String?
  balance              Float     @default(0)
  currencyCode         String    @default("BRL")
  creditBrand          String?
  creditLevel          String?
  creditLimit          Float?
  availableCreditLimit Float?
  minimumPayment       Float?
  balanceCloseDate     DateTime?
  balanceDueDate       DateTime?
  /** Dia de vencimento informado (override da Pluggy, que pode estar atrasada). */
  billDueDay           Int?
  /** Dia de fechamento informado. Se vazio, usa vencimento − 7. */
  billCloseDay         Int?
  connectionId         String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  connection      BankConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurringBills  RecurringBill[]
  managedAccounts ManagedAccount[]
  creditBills     CreditCardBill[]
  billPaidMarks   CardBillPaidMark[]

  @@index([connectionId])
}

/** Fatura persistida da Pluggy (só fechadas no Open Finance). */
model CreditCardBill {
  id                   String    @id @default(cuid())
  pluggyBillId         String    @unique
  accountId            String
  dueDate              DateTime
  closingDate          DateTime?
  totalAmount          Float
  minimumPaymentAmount Float?
  source               String    @default("pluggy")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, dueDate])
}

/// Fatura que a pessoa marcou como paga ("Marcar fatura como paga") quando o app
/// não reconhece o pagamento no extrato. O ciclo da fatura fecha nesse dia.
model CardBillPaidMark {
  id        String   @id @default(cuid())
  accountId String
  /// Mês da fatura (AAAA-MM).
  billMonth String
  paidOn    DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, billMonth])
}

model Transaction {
  id                  String   @id @default(cuid())
  pluggyTransactionId String   @unique
  date                DateTime
  description         String
  amount              Float
  currencyCode        String   @default("BRL")
  pluggyCategory      String?
  category            String?
  userCategory        String?
  categorySource      String?
  categoryConfidence  Float?
  merchantName        String?
  /** Mês da fatura em que a compra cai (AAAA-MM), informado pela Pluggy. */
  billForecastMonth   String?
  /** Fatura da Pluggy a que o lançamento do cartão pertence (creditCardMetadata.billId). */
  pluggyBillId        String?
  accountId           String
  createdAt           DateTime @default(now())

  account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  anchorCommitment           PaymentCommitment?        @relation("AnchorTransaction")
  installmentPayment         PaymentInstallment?
  linkedScenarios            SimulationScenario[]
  recurringBillOccurrence      RecurringBillOccurrence?
  managedAccountAnchor         ManagedAccount?           @relation("ManagedAccountAnchor")
  managedAccountEntryPayment   ManagedAccountEntry?

  @@index([accountId])
  @@index([date])
  @@index([pluggyBillId])
}

model PaymentCommitment {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  payeeName           String?
  notes               String?
  totalAmount         Float
  installmentAmount   Float
  totalInstallments   Int
  dayOfMonth          Int?
  status              String   @default("active")
  /** "manual" (criado a partir de uma transação) ou "auto_detected" (parcelas n/m do cartão). */
  source              String   @default("manual")
  /** Cartão das parcelas, para compromissos detectados automaticamente. */
  accountId           String?
  anchorTransactionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments PaymentInstallment[]
  anchorTx     Transaction?         @relation("AnchorTransaction", fields: [anchorTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model PaymentInstallment {
  id            String    @id @default(cuid())
  commitmentId  String
  sequence      Int
  dueDate       DateTime
  amount        Float
  status        String    @default("pending")
  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commitment  PaymentCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([commitmentId, sequence])
  @@index([commitmentId])
  @@index([status])
  @@index([dueDate])
}

model RecurringBill {
  id                 String    @id @default(cuid())
  userId             String
  personId           String?
  accountId          String?
  title              String
  payeeName          String?
  matchSignature     String
  category           String?
  expectedAmount     Float
  dayOfMonth         Int
  status             String    @default("active")
  source             String    @default("auto_detected")
  lastOccurrenceDate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person?                   @relation(fields: [personId], references: [id], onDelete: SetNull)
  account     Account?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  occurrences RecurringBillOccurrence[]

  @@unique([userId, matchSignature, accountId])
  @@index([userId])
  @@index([status])
}

model RecurringBillOccurrence {
  id            String    @id @default(cuid())
  billId        String
  cycleKey      String
  dueDate       DateTime
  amount        Float
  status        String    @default("pending")
  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bill        RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, cycleKey])
  @@index([billId])
  @@index([status])
  @@index([dueDate])
}

model ManagedAccount {
  id                       String    @id @default(cuid())
  userId                   String
  personId                 String?
  title                    String
  payeeName                String?
  category                 String?
  notes                    String?
  kind                     String
  simulationType           String?
  source                   String
  status                   String    @default("active")
  expectedAmount           Float
  totalAmount              Float?
  totalInstallments        Int?
  dayOfMonth               Int?
  matchSignature           String?
  anchorTransactionId      String?   @unique
  bankAccountId            String?
  linkedTransactionId      String?
  simulationPayload        Json?
  lastVerdict              String?
  lastImpactSnapshot       Json?
  priority                 Int       @default(0)
  description              String?
  lastOccurrenceDate       DateTime?
  completedAt              DateTime?
  legacyRecurringBillId    String?   @unique
  legacyCommitmentId       String?   @unique
  legacySimulationScenarioId String? @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  person            Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  bankAccount       Account?              @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  anchorTransaction Transaction?          @relation("ManagedAccountAnchor", fields: [anchorTransactionId], references: [id], onDelete: SetNull)
  entries           ManagedAccountEntry[]

  @@index([userId])
  @@index([userId, status])
  @@index([personId])
  @@index([kind])
}

model ManagedAccountEntry {
  id               String    @id @default(cuid())
  managedAccountId String
  sequence         Int?
  cycleKey         String?
  dueDate          DateTime
  amount           Float
  status           String    @default("pending")
  transactionId    String?   @unique
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  managedAccount ManagedAccount @relation(fields: [managedAccountId], references: [id], onDelete: Cascade)
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([managedAccountId, cycleKey])
  @@unique([managedAccountId, sequence])
  @@index([managedAccountId])
  @@index([status])
  @@index([dueDate])
}

model CategoryMapping {
  id       String @id @default(cuid())
  userId   String
  pattern  String
  category String
  source   String
  hitCount Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
}

model Investment {
  id                  String    @id @default(cuid())
  pluggyInvestmentId  String    @unique
  name                String
  type                String?
  subtype             String?
  code                String?
  isin                String?
  status              String    @default("ACTIVE")
  balance             Float     @default(0)
  amount              Float?
  amountOriginal      Float?
  amountProfit        Float?
  amountWithdrawal    Float?
  quantity            Float?
  value               Float?
  rate                Float?
  rateType            String?
  annualRate          Float?
  lastMonthRate       Float?
  lastTwelveMonthsRate Float?
  currencyCode        String    @default("BRL")
  purchaseDate        DateTime?
  dueDate             DateTime?
  /** Data em que a instituição reportou a posição (campo date da Pluggy). */
  positionDate        DateTime?
  owner               String?
  connectionId        String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  connection   BankConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]

  @@index([connectionId])
  @@index([status])
}

model InvestmentTransaction {
  id                          String   @id @default(cuid())
  pluggyInvestmentTransactionId String @unique
  date                        DateTime
  tradeDate                   DateTime?
  type                        String?
  amount                      Float
  netAmount                   Float?
  quantity                    Float?
  value                       Float?
  description                 String?
  movementType                String?
  investmentId                String
  createdAt                   DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([date])
}

model ChatThread {
  id         String   @id @default(cuid())
  title      String   @default("Nova conversa")
  contextKey String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@unique([userId, contextKey])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  metadata  Json?
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread   ChatThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
}

model SimulationScenario {
  id                   String    @id @default(cuid())
  userId               String
  personId             String?
  name                 String
  description          String?
  type                 String
  status               String    @default("draft")
  payload              Json
  priority             Int       @default(0)
  linkedTransactionId  String?
  linkedInvestmentTxId String?
  linkedCommitmentId   String?
  lastVerdict          String?
  lastImpactSnapshot   Json?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person            Person?                @relation(fields: [personId], references: [id], onDelete: SetNull)
  linkedTransaction Transaction?           @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([personId])
}

