generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  paydayDay                    Int?
  defaultPeriodMode            String   @default("calendar")
  includeInvestmentsInNetWorth Boolean  @default(true)
  theme                        String   @default("default")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  people              Person[]
  chatMessages        ChatMessage[]
  chatThreads         ChatThread[]
  budgets             BudgetGroup[]
  goals               Goal[]
  plans               Plan[]
  chatActionProposals ChatActionProposal[]
  categoryMappings    CategoryMapping[]
  paymentCommitments  PaymentCommitment[]
}

model Person {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  paydayDay         Int?
  paydayCycleAnchor String   @default("end")
  userId            String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections BankConnection[]

  @@index([userId])
}

model BankConnection {
  id                String    @id @default(cuid())
  pluggyItemId      String    @unique
  connectorName     String?
  connectorImageUrl String?
  status            String    @default("UPDATING")
  lastSyncedAt      DateTime?
  personId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  person   Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  accounts Account[]
  investments Investment[]

  @@index([personId])
}

model Account {
  id                   String    @id @default(cuid())
  pluggyAccountId      String    @unique
  name                 String
  type                 String?
  subtype              String?
  number               String?
  balance              Float     @default(0)
  currencyCode         String    @default("BRL")
  creditBrand          String?
  creditLevel          String?
  creditLimit          Float?
  availableCreditLimit Float?
  minimumPayment       Float?
  balanceCloseDate     DateTime?
  balanceDueDate       DateTime?
  connectionId         String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goalSources  GoalSource[]

  @@index([connectionId])
}

model Transaction {
  id                  String   @id @default(cuid())
  pluggyTransactionId String   @unique
  date                DateTime
  description         String
  amount              Float
  currencyCode        String   @default("BRL")
  pluggyCategory      String?
  category            String?
  userCategory        String?
  categorySource      String?
  categoryConfidence  Float?
  merchantName        String?
  accountId           String
  createdAt           DateTime @default(now())

  account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  anchorCommitment   PaymentCommitment?   @relation("AnchorTransaction")
  installmentPayment PaymentInstallment?

  @@index([accountId])
  @@index([date])
}

model PaymentCommitment {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  payeeName           String?
  notes               String?
  totalAmount         Float
  installmentAmount   Float
  totalInstallments   Int
  dayOfMonth          Int?
  status              String   @default("active")
  anchorTransactionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments PaymentInstallment[]
  anchorTx     Transaction?         @relation("AnchorTransaction", fields: [anchorTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model PaymentInstallment {
  id            String    @id @default(cuid())
  commitmentId  String
  sequence      Int
  dueDate       DateTime
  amount        Float
  status        String    @default("pending")
  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commitment  PaymentCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([commitmentId, sequence])
  @@index([commitmentId])
  @@index([status])
  @@index([dueDate])
}

model CategoryMapping {
  id       String @id @default(cuid())
  userId   String
  pattern  String
  category String
  source   String
  hitCount Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
}

model Investment {
  id                  String    @id @default(cuid())
  pluggyInvestmentId  String    @unique
  name                String
  type                String?
  subtype             String?
  code                String?
  isin                String?
  status              String    @default("ACTIVE")
  balance             Float     @default(0)
  amount              Float?
  amountOriginal      Float?
  amountProfit        Float?
  amountWithdrawal    Float?
  quantity            Float?
  value               Float?
  rate                Float?
  rateType            String?
  annualRate          Float?
  lastMonthRate       Float?
  lastTwelveMonthsRate Float?
  currencyCode        String    @default("BRL")
  purchaseDate        DateTime?
  dueDate             DateTime?
  /** Data em que a instituição reportou a posição (campo date da Pluggy). */
  positionDate        DateTime?
  owner               String?
  connectionId        String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  connection   BankConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]
  goalSources  GoalSource[]

  @@index([connectionId])
  @@index([status])
}

model InvestmentTransaction {
  id                          String   @id @default(cuid())
  pluggyInvestmentTransactionId String @unique
  date                        DateTime
  tradeDate                   DateTime?
  type                        String?
  amount                      Float
  netAmount                   Float?
  quantity                    Float?
  value                       Float?
  description                 String?
  movementType                String?
  investmentId                String
  createdAt                   DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([date])
}

model ChatThread {
  id         String   @id @default(cuid())
  title      String   @default("Nova conversa")
  contextKey String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  proposals ChatActionProposal[]

  @@unique([userId, contextKey])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  metadata  Json?
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread   ChatThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  proposal ChatActionProposal?

  @@index([userId])
  @@index([threadId])
}

model BudgetGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  limit     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  members BudgetGroupMember[]

  @@unique([userId, name])
  @@index([userId])
}

model BudgetGroupMember {
  id            String @id @default(cuid())
  budgetGroupId String
  userId        String
  categoryGroup String

  budgetGroup BudgetGroup @relation(fields: [budgetGroupId], references: [id], onDelete: Cascade)

  @@unique([budgetGroupId, categoryGroup])
  @@unique([userId, categoryGroup])
  @@index([budgetGroupId])
}

model Goal {
  id                String    @id @default(cuid())
  userId            String
  name              String
  description       String?
  type              String
  icon              String?
  targetAmount      Float
  currentAmount     Float     @default(0)
  targetDate        DateTime?
  status            String    @default("active")
  trackingMode      String    @default("manual")
  lastSyncedBalance Float?
  linkedAccountId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  planGoals     PlanGoal[]
  sources       GoalSource[]

  @@index([userId])
}

model GoalSource {
  id                String   @id @default(cuid())
  goalId            String
  sourceType        String
  accountId         String?
  investmentId      String?
  allocationPercent Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([goalId, accountId])
  @@unique([goalId, investmentId])
  @@index([goalId])
  @@index([accountId])
  @@index([investmentId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  amount    Float
  date      DateTime
  source    String
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Plan {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  description         String?
  monthlyContribution Float    @default(0)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  members PlanGoal[]

  @@index([userId])
}

model PlanGoal {
  id                String @id @default(cuid())
  planId            String
  goalId            String
  monthlyAllocation Float  @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([planId, goalId])
  @@index([planId])
  @@index([goalId])
}

model ChatActionProposal {
  id         String    @id @default(cuid())
  userId     String
  threadId   String
  messageId  String?   @unique
  type       String
  payload    Json
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread  ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([threadId])
}
