generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  people       Person[]
  chatMessages ChatMessage[]
  chatThreads  ChatThread[]
  budgets      BudgetGroup[]
}

model Person {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections BankConnection[]

  @@index([userId])
}

model BankConnection {
  id                String    @id @default(cuid())
  pluggyItemId      String    @unique
  connectorName     String?
  connectorImageUrl String?
  status            String    @default("UPDATING")
  lastSyncedAt      DateTime?
  personId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([personId])
}

model Account {
  id              String   @id @default(cuid())
  pluggyAccountId String   @unique
  name            String
  type            String?
  subtype         String?
  number          String?
  balance         Float    @default(0)
  currencyCode    String   @default("BRL")
  creditBrand            String?
  creditLevel            String?
  creditLimit            Float?
  availableCreditLimit   Float?
  minimumPayment         Float?
  balanceCloseDate       DateTime?
  balanceDueDate         DateTime?
  connectionId    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([connectionId])
}

model Transaction {
  id                  String   @id @default(cuid())
  pluggyTransactionId String   @unique
  date                DateTime
  description         String
  amount              Float
  currencyCode        String   @default("BRL")
  category            String?
  accountId           String
  createdAt           DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
}

model ChatThread {
  id        String   @id @default(cuid())
  title     String   @default("Nova conversa")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
}

model BudgetGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  limit     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  members BudgetGroupMember[]

  @@unique([userId, name])
  @@index([userId])
}

model BudgetGroupMember {
  id            String @id @default(cuid())
  budgetGroupId String
  userId        String
  categoryGroup String

  budgetGroup BudgetGroup @relation(fields: [budgetGroupId], references: [id], onDelete: Cascade)

  @@unique([budgetGroupId, categoryGroup])
  @@unique([userId, categoryGroup])
  @@index([budgetGroupId])
}
